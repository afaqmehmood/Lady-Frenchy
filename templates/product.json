    "faq_LQrxVU": {
      "type": "faq",
      "blocks": {
        "item_nxXWD4": {
          "type": "item",
          "settings": {
            "title": "Quelle est la composition du foulard ?",
            "content": "<p>Nos foulards sont confectionnés à <strong>100 % en polyester satiné</strong> de haute qualité, offrant la douceur et l'élégance d’un tissu soyeux.</p>"
          }
        },
        "item_KG6grz": {
          "type": "item",
          "settings": {
            "title": "Le foulard est-il hypoallergénique ?",
            "content": "<p>Le polyester satiné est généralement bien toléré, mais en cas de doute, nous vous conseillons de tester le foulard sur une petite zone de peau avant de le porter.</p>"
          }
        },
        "item_ec46cP": {
          "type": "item",
          "settings": {
            "title": "Le foulard est-il respirant ?",
            "content": "<p>Nos foulards en polyester satiné sont <strong>légers et respirants</strong>, offrant confort et luxe tout au long de la journée.</p>"
          }
        },
        "item_dxtyUi": {
          "type": "item",
          "settings": {
            "title": "Le foulard se froisse-t-il facilement ?",
            "content": "<p>Le polyester satiné est <strong>moins sujet aux plis que la soie pure</strong>. Pour préserver leur aspect, il est recommandé de les ranger soigneusement ou de les suspendre.</p>"
          }
        },
        "item_39KVF7": {
          "type": "item",
          "settings": {
            "title": "Comment entretenir mon foulard ?",
            "content": "<p>Faciles à entretenir, nos foulards satinés peuvent être <strong>lavés en machine à basse température</strong>. Nous conseillons un <strong>lavage délicat</strong> pour préserver la qualité du tissu.</p>"
          }
        },
        "item_69B6dw": {
          "type": "item",
          "settings": {
            "title": "Puis-je repasser le foulard ?",
            "content": "<p>Oui, vous pouvez repasser le foulard satiné à <strong>basse température</strong> pour éliminer les plis éventuels.</p>"
          }
        },
        "item_ePJmRT": {
          "type": "item",
          "settings": {
            "title": "Le foulard déteint-il au lavage ?",
            "content": "<p>Nos foulards satinés <strong>résistent bien à la décoloration</strong>. Pour les premières fois, nous recommandons de <strong>laver les couleurs foncées séparément</strong>.</p>"
          }
        },
        "item_HH6Yrm": {
          "type": "item",
          "settings": {
            "title": "Le foulard est-il adapté pour toutes les saisons ?",
            "content": "<p><strong>Absolument !</strong> Grâce à leur <strong>légèreté et respirabilité</strong>, nos foulards satinés conviennent <strong>à toutes les saisons</strong>.</p>"
          }
        }
      },
